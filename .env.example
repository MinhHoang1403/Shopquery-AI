GEMINI_API_KEY=
AI_DEFAULT_MODEL=inetcloud-knowledge

# Google OIDC: configure real values only in your private .env.
APP_ENVIRONMENT=development
APP_ORIGIN=http://127.0.0.1:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_INVITED_EMAILS=[]
AUTH_SESSION_HOURS=12
API_DOCS_ENABLED=false
# Explicit permission to transmit questions, SQL results and document text to providers.
BETA_PROVIDER_DATA_ENABLED=false
BETA_LOGIN_PER_IP_HOUR=20
BETA_CHAT_PER_USER_HOUR=30
BETA_UPLOAD_PER_USER_HOUR=10
BETA_USER_CONCURRENCY=1
BETA_SYSTEM_CONCURRENCY=4
BETA_MAX_DATASETS=20
BETA_MAX_USER_BYTES=104857600
# Set the company provider's HTTPS Chat Completions base URL locally.
INETCLOUD_BASE_URL=
INETCLOUD_MODEL=knowledge
INETCLOUD_TIMEOUT_SECONDS=60
INETCLOUD_RETRY_ATTEMPTS=1
# Allows sending generation context to Google after a qualifying primary failure.
AI_GEMINI_FALLBACK_ENABLED=false
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_REQUEST_TIMEOUT_MS=30000
GEMINI_RETRY_ATTEMPTS=3
EMBEDDING_DIMENSIONS=768
DATABASE_SETUP_URL=postgresql+psycopg://shopquery_setup:setup_password@127.0.0.1:54321/shopquery
DATABASE_READONLY_URL=postgresql+psycopg://shopquery_reader:readonly_password@127.0.0.1:54321/shopquery
DEMO_REFERENCE_DATE=2026-10-01
CORS_ORIGINS=["http://localhost:5173"]
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=200
LOG_LEVEL=INFO

# Guest uploads are temporary. AI requires BOTH flags; leave disabled until approved.
GUEST_ENABLED=true
GUEST_AI_ENABLED=false
GUEST_SESSION_SECONDS=600
GUEST_CLEANUP_SECONDS=15
GUEST_MAX_SESSIONS=20
GUEST_QUESTIONS_PER_SESSION=5
GUEST_CHAT_PER_IP_HOUR=10
GUEST_SESSIONS_PER_IP_HOUR=20
GUEST_UPLOADS_PER_IP_HOUR=10
GUEST_SYSTEM_CONCURRENCY=2
GUEST_MAX_FILES=2
GUEST_MAX_FILE_BYTES=2097152
GUEST_MAX_SESSION_BYTES=10485760
GUEST_MAX_TOTAL_BYTES=67108864
GUEST_MAX_ROWS=1000
GUEST_MAX_COLUMNS=20
GUEST_MAX_PAGES=20
GUEST_MAX_CHARACTERS=100000
GUEST_MAX_CHUNKS=12
GUEST_MAX_PROMPT_CHARACTERS=2000
GUEST_PARSE_TIMEOUT_SECONDS=10
GUEST_REQUEST_TIMEOUT_SECONDS=120
GUEST_WORKER_MEMORY_MB=768
GUEST_WORKER_CPU_SECONDS=15
