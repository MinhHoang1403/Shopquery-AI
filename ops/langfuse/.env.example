# Copy to .env ONLY on the approved Langfuse host; never commit real values.
# Generate separate random URL-safe values (for example: openssl rand -hex 32).
# Use hexadecimal for PostgreSQL to avoid URL-encoding ambiguity in DATABASE_URL.
LF_POSTGRES_PASSWORD=
LF_CLICKHOUSE_PASSWORD=
LF_REDIS_PASSWORD=
LF_MINIO_USER=
LF_MINIO_PASSWORD=
LF_NEXTAUTH_SECRET=
LF_SALT=
# Exactly 64 hex characters, representing 32 random bytes.
LF_ENCRYPTION_KEY=
# Local Docker Desktop UI/media; no remote telemetry endpoint is configured.
LF_PUBLIC_URL=http://127.0.0.1:3000
LF_MEDIA_URL=http://127.0.0.1:9090
